---
import Base from '../../layouts/Base.astro';
import { getPosts, groupBy, slugify } from '../../lib';
const groups = groupBy(await getPosts(), (p) => p.data.tags);
---
<Base title="Tags">
  <h1>Tags</h1>
  <ul class="posts">
    {[...groups].map(([name, posts]) => (
      <li><a href={`/tags/${slugify(name)}/`}>{name}</a> <span class="meta">{posts.length}</span></li>
    ))}
  </ul>
</Base>
